{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "A project profile (TOML). Only name is required.",
 "type": "object",
 "required": [
  "name"
 ],
 "properties": {
  "name": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]+$"
  },
  "machine_id": {
   "type": "string"
  },
  "names": {
   "type": "object",
   "properties": {
    "owner": {
     "type": "string"
    },
    "recipient": {
     "type": "string"
    },
    "trim_command": {
     "type": "string"
    },
    "disk_command": {
     "type": "string"
    },
    "jobs_file": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "service": {
   "type": "object",
   "properties": {
    "label_prefix": {
     "type": "string",
     "pattern": "^[A-Za-z0-9.-]+$"
    },
    "rollback_notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "path_extra": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "folders added to the service PATH (before the system folders), for tools the profile's scripts call"
    }
   },
   "additionalProperties": false
  },
  "sizes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "live_tools": {
   "type": "object",
   "properties": {
    "names": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "suffixes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "path_regexes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "memory_guard": {
   "type": "object",
   "properties": {
    "state_file": {
     "type": "string"
    },
    "heartbeat_key": {
     "type": "string"
    },
    "pid_key": {
     "type": "string"
    },
    "kills_log": {
     "type": "string"
    },
    "max_age_s": {
     "type": "number"
    }
   },
   "additionalProperties": false
  },
  "queue": {
   "type": "object",
   "required": [
    "adapter",
    "dir"
   ],
   "properties": {
    "adapter": {
     "enum": [
      "fifo-gates"
     ]
    },
    "dir": {
     "type": "string"
    },
    "slots_file": {
     "type": "string"
    },
    "sample_log": {
     "type": "string"
    },
    "history_log": {
     "type": "string"
    },
    "launcher": {
     "type": "string"
    },
    "exclusive_env": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "wide_mode_kind": {
     "type": "string"
    },
    "exclusive_mode_kind": {
     "type": "string"
    },
    "kind_patterns": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 2
     }
    }
   },
   "additionalProperties": false
  },
  "kinds": {
   "type": "object",
   "properties": {
    "wide": {
     "type": "string"
    },
    "machine_only": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "pool": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 1
     }
    }
   },
   "additionalProperties": false
  },
  "ci": {
   "type": "object",
   "required": [
    "adapter",
    "pool_id",
    "repo",
    "billing_path",
    "guard_argv"
   ],
   "properties": {
    "adapter": {
     "enum": [
      "github-gh"
     ]
    },
    "pool_id": {
     "type": "string"
    },
    "repo": {
     "type": "string",
     "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "billing_path": {
     "type": "string"
    },
    "linux_sku": {
     "type": "string"
    },
    "guard_argv": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "guard_cwd": {
     "type": "string"
    },
    "job_minutes": {
     "type": "number"
    },
    "plan_minutes": {
     "type": "number"
    },
    "dispatch_kinds": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "push_command": {
     "type": "string"
    },
    "dispatch_argv": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "scratch_command": {
     "type": "string"
    },
    "noise": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "workflow": {
        "type": "string"
       },
       "workflow_regex": {
        "type": "string"
       },
       "event": {
        "type": "string"
       },
       "branch_regex": {
        "type": "string"
       }
      },
      "additionalProperties": false
     }
    },
    "guard_args": {
     "type": "object",
     "description": "per job kind (or 'default'): the guard's arguments; placeholders {kind} {shards} {race} {packages} {crate} {diff_base}",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "guard_defaults": {
     "type": "object",
     "description": "values for placeholders the request leaves empty",
     "additionalProperties": {
      "type": "string"
     }
    },
    "runner_labels": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "self-hosted runners for mm resources: a runner is listed when it carries every one of these labels (as runs-on matches); read only when set"
    }
   },
   "additionalProperties": false
  },
  "delivery": {
   "type": "object",
   "required": [
    "adapter"
   ],
   "properties": {
    "adapter": {
     "enum": [
      "claude-code-hook"
     ]
    },
    "recipient_file": {
     "type": "string"
    },
    "recipient_regex": {
     "type": "string"
    },
    "jobs_file": {
     "type": "string"
    },
    "jobs_end_marker": {
     "type": "string"
    },
    "transcripts_dir": {
     "type": "string"
    },
    "usage_state": {
     "type": "string"
    },
    "investigator": {
     "type": "string"
    },
    "launch_tools": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "launch_bash_regex": {
     "type": "string"
    },
    "ignore_wait_tools": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "settings_file": {
     "type": "string"
    },
    "jobs_base": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "trim": {
   "type": "object",
   "properties": {
    "cache": {
     "type": "string"
    },
    "marker_file": {
     "type": "string"
    },
    "marker_text": {
     "type": "string"
    },
    "warm_argv": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "deletes": {
   "type": "object",
   "properties": {
    "forbidden_parts": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "protected_roots": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "rules": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "type"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "enum": [
         "own_files",
         "folders",
         "cache_entries",
         "app_folders",
         "command_per_dir",
         "trim",
         "note"
        ]
       }
      }
     }
    },
    "cleanup": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "type"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "enum": [
         "git_worktrees",
         "git_branches",
         "stale_children",
         "paths"
        ]
       }
      },
      "anyOf": [
       {
        "properties": {
         "type": {
          "const": "git_worktrees"
         },
         "keep": {
          "type": "array",
          "items": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       },
       {
        "properties": {
         "type": {
          "enum": [
           "git_branches",
           "stale_children",
           "paths"
          ]
         }
        }
       }
      ]
     }
    }
   },
   "additionalProperties": false
  },
  "recovery": {
   "type": "object",
   "description": "Self-recovery: the detached jobs that should run after a Mac reboot (MAC_REBOOTED names the missing ones).",
   "properties": {
    "expected_jobs": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "name",
       "match"
      ],
      "properties": {
       "name": {
        "type": "string"
       },
       "match": {
        "type": "string",
        "description": "a regular expression over a process's command line"
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "text_line_max": {
   "type": "integer",
   "minimum": 256,
   "maximum": 1048576,
   "description": "C-22: the longest line any pattern sees; longer lines are cut with a mark (default 4096)"
  },
  "pools": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "adapter",
     "id",
     "repo",
     "billing_path",
     "guard_argv"
    ],
    "properties": {
     "adapter": {
      "enum": [
       "github-gh"
      ]
     },
     "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
     },
     "billing_path": {
      "type": "string"
     },
     "linux_sku": {
      "type": "string"
     },
     "guard_argv": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "guard_cwd": {
      "type": "string"
     },
     "job_minutes": {
      "type": "number"
     },
     "plan_minutes": {
      "type": "number"
     },
     "dispatch_kinds": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "push_command": {
      "type": "string"
     },
     "dispatch_argv": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "scratch_command": {
      "type": "string"
     },
     "noise": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "workflow": {
         "type": "string"
        },
        "workflow_regex": {
         "type": "string"
        },
        "event": {
         "type": "string"
        },
        "branch_regex": {
         "type": "string"
        }
       },
       "additionalProperties": false
      }
     },
     "guard_args": {
      "type": "object",
      "description": "per job kind (or 'default'): the guard's arguments; placeholders {kind} {shards} {race} {packages} {crate} {diff_base}",
      "additionalProperties": {
       "type": "array",
       "items": {
        "type": "string"
       }
      }
     },
     "guard_defaults": {
      "type": "object",
      "description": "values for placeholders the request leaves empty",
      "additionalProperties": {
       "type": "string"
      }
     },
     "runner_labels": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "self-hosted runners for mm resources: a runner is listed when it carries every one of these labels (as runs-on matches); read only when set"
     },
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
     },
     "reserve_minutes": {
      "type": "number",
      "minimum": 0
     },
     "included_minutes": {
      "type": "number",
      "minimum": 0
     }
    },
    "additionalProperties": false
   },
   "description": "Independent pools; replaces [ci]. Each id is unique. Budget overrides inherit github settings when omitted."
  }
 },
 "additionalProperties": false
}
