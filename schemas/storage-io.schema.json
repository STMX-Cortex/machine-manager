{
 "type": "object",
 "required": [
  "schema_version",
  "kind",
  "machine_id",
  "time",
  "state",
  "reason",
  "requested_interval_s",
  "devices",
  "removed_ids"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "const": 1
  },
  "kind": {
   "const": "storage_io"
  },
  "machine_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 120
  },
  "time": {
   "type": "number",
   "minimum": 0,
   "maximum": 9007199254740991
  },
  "state": {
   "enum": [
    "OK",
    "PARTIAL",
    "UNKNOWN"
   ]
  },
  "reason": {
   "enum": [
    null,
    "unsupported",
    "permission_denied",
    "timeout",
    "read_failed",
    "invalid_data",
    "truncated"
   ]
  },
  "requested_interval_s": {
   "type": "number",
   "minimum": 0.1,
   "maximum": 30
  },
  "devices": {
   "type": "array",
   "maxItems": 128,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "scope",
     "time",
     "counters",
     "counter_reason",
     "interval_s",
     "rates",
     "rate_reason"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^device:(uuid|wwn|native|session):[0-9a-f]{64}$",
      "maxLength": 96
     },
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
     },
     "scope": {
      "enum": [
       "whole_device",
       "driver"
      ]
     },
     "time": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
     },
     "counters": {
      "type": "object",
      "required": [
       "read_bytes",
       "write_bytes",
       "read_ops",
       "write_ops"
      ],
      "properties": {
       "read_bytes": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615
       },
       "write_bytes": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615
       },
       "read_ops": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615
       },
       "write_ops": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615
       }
      },
      "additionalProperties": false
     },
     "counter_reason": {
      "enum": [
       null,
       "unsupported",
       "permission_denied",
       "timeout",
       "read_failed",
       "invalid_data",
       "truncated"
      ]
     },
     "interval_s": {
      "type": [
       "number",
       "null"
      ],
      "minimum": 0.001,
      "maximum": 60
     },
     "rates": {
      "type": "object",
      "required": [
       "read_bytes_per_s",
       "write_bytes_per_s",
       "read_ops_per_s",
       "write_ops_per_s"
      ],
      "properties": {
       "read_bytes_per_s": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615000
       },
       "write_bytes_per_s": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615000
       },
       "read_ops_per_s": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615000
       },
       "write_ops_per_s": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0,
        "maximum": 18446744073709551615000
       }
      },
      "additionalProperties": false
     },
     "rate_reason": {
      "enum": [
       null,
       "unsupported",
       "permission_denied",
       "timeout",
       "read_failed",
       "invalid_data",
       "truncated",
       "baseline_missing",
       "counter_reset",
       "identity_changed",
       "interval_invalid"
      ]
     }
    },
    "additionalProperties": false
   }
  },
  "removed_ids": {
   "type": "array",
   "maxItems": 128,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^device:(uuid|wwn|native|session):[0-9a-f]{64}$",
    "maxLength": 96
   }
  }
 },
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Standalone storage device I/O observation",
 "description": "Requires mmstorage_io.valid semantic validation. Device/driver counters are not additive across storage layers and are never per-filesystem metrics."
}
