{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "The status record of a machine or a pool, written every tick (status.json, pools/<id>.json)",
 "type": "object",
 "required": [
  "kind",
  "time",
  "state",
  "machine_id",
  "schema_version"
 ],
 "properties": {
  "machine_id": {
   "type": "string",
   "minLength": 1
  },
  "schema_version": {
   "const": 1
  },
  "kind": {
   "enum": [
    "machine",
    "pool"
   ]
  },
  "time": {
   "type": "number"
  },
  "state": {
   "enum": [
    "GREEN",
    "STEADY",
    "AMBER",
    "RED",
    "UNKNOWN"
   ]
  },
  "reasons": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "red_since": {
   "type": [
    "number",
    "null"
   ]
  },
  "mode": {
   "enum": [
    "act",
    "observe",
    "off",
    "safe",
    "dry"
   ]
  },
  "slots": {
   "type": [
    "integer",
    "null"
   ],
   "description": "the queue's real slot count (its slots file), or null when the queue cannot be read"
  },
  "slots_would": {
   "type": [
    "integer",
    "null"
   ],
   "description": "the slot controller's count: what it set, or in observe mode what it would set"
  },
  "busy": {
   "type": "integer"
  },
  "waiting": {
   "type": "integer"
  },
  "readings": {
   "type": "object",
   "additionalProperties": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "disk_gb": {
   "type": [
    "number",
    "null"
   ]
  },
  "sampler": {
   "enum": [
    "fast",
    "commands"
   ]
  },
  "alerts": {
   "anyOf": [
    {
     "type": "object",
     "additionalProperties": {
      "type": "integer"
     }
    },
    {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   ]
  },
  "heartbeat": {
   "type": "object",
   "required": [
    "pid",
    "tick",
    "note"
   ],
   "properties": {
    "pid": {
     "type": "integer"
    },
    "tick": {
     "type": "integer"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "capacity": {
   "type": "object"
  },
  "load": {
   "type": "object"
  },
  "read_time": {
   "type": [
    "number",
    "null"
   ]
  },
  "facts": {
   "type": "object",
   "description": "machine: static facts read once at the supervisor's start (mm resources)",
   "properties": {
    "cores": {
     "type": [
      "integer",
      "null"
     ]
    },
    "p_cores": {
     "type": [
      "integer",
      "null"
     ]
    },
    "e_cores": {
     "type": [
      "integer",
      "null"
     ]
    },
    "cpu_model": {
     "type": [
      "string",
      "null"
     ]
    },
    "ram_mb": {
     "type": [
      "integer",
      "null"
     ]
    },
    "disk_gb_total": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "calls": {
   "type": [
    "integer",
    "null"
   ],
   "description": "machine: distinct queue calls holding slots (one call may hold several), or null when the queue cannot be read"
  },
  "idle_minutes": {
   "type": [
    "number",
    "null"
   ],
   "description": "machine: minutes the queue has been idle (the IDLE_ROOM span), or null when it is not idle"
  },
  "money": {
   "type": "object",
   "description": "pool: money used and allowed this month",
   "properties": {
    "used_usd": {
     "type": [
      "number",
      "null"
     ]
    },
    "allowed_usd": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "runners": {
   "type": "array",
   "description": "pool: the self-hosted runners that carry every ci.runner_labels label",
   "items": {
    "type": "object",
    "required": [
     "name",
     "online",
     "busy",
     "labels"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "online": {
      "type": "boolean"
     },
     "busy": {
      "type": "boolean"
     },
     "labels": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "additionalProperties": false
   }
  },
  "runners_error": {
   "type": [
    "string",
    "null"
   ],
   "description": "pool: why the runner list could not be read (masked); no runners then"
  }
 },
 "additionalProperties": false
}
