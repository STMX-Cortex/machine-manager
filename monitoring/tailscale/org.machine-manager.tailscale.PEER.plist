<plist version="1.0"><dict>
  <key>Label</key><string>org.machine-manager.tailscale.PEER</string>
  <key>ProgramArguments</key><array>
    <string>/ABS/PYTHON3</string><string>-I</string><string>/ABS/MACHINE_MANAGER/bin/mm</string>
    <string>tailscale</string><string>--peer</string><string>PEER.TAILNET.ts.net</string>
