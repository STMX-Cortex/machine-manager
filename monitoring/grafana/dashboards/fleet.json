{
  "uid": "mm-fleet",
  "title": "Machine Manager / Fleet",
  "description": "Fleet snapshots and history. Unknown readings remain gaps. Producer identifies the scrape endpoint; never sum duplicate producers. Monitoring has no control authority.",
  "tags": [
    "machine-manager"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Machine Manager Prometheus",
          "value": "mm-prometheus"
        },
        "options": []
      },
      {
        "name": "job",
        "type": "constant",
        "query": "machine-manager",
        "current": {
          "text": "machine-manager",
          "value": "machine-manager"
        },
        "hide": 2
      },
      {
        "name": "instance",
        "label": "Producer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "variable-instance"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "machine",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(machine_manager_machine_status_fresh{job=\"$job\",instance=~\"${instance}\"}, machine_id)",
          "refId": "variable-machine"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Fleet",
      "type": "link",
      "url": "/d/mm-fleet",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Resources",
      "type": "link",
      "url": "/d/mm-resources",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Storage",
      "type": "link",
      "url": "/d/mm-storage",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Exporter scrape success (1 = reachable)",
      "type": "timeseries",
      "description": "Independent of supervisor freshness. Zero means scrape failure; absent means no target/data.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\",instance=~\"${instance}\"}",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Machine snapshot freshness (1 = fresh)",
      "type": "timeseries",
      "description": "A fresh snapshot may still report RED, off, observe, safe or dry mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "machine_manager_machine_status_fresh{job=\"$job\",instance=~\"${instance}\",machine_id=~\"${machine}\"}",
          "legendFormat": "{{instance}} / {{machine_id}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Current machine state",
      "type": "table",
      "description": "One active state per source and machine. Stale/missing sources report UNKNOWN while the endpoint is reachable.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "machine_manager_machine_state{job=\"$job\",instance=~\"${instance}\",machine_id=~\"${machine}\"} == 1",
          "legendFormat": "{{instance}} / {{machine_id}}",
          "range": false,
          "instant": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "Value": true,
              "alertstate": true
            },
            "indexByName": {
              "machine_id": 0,
              "state": 1,
              "instance": 2
            },
            "renameByName": {
              "machine_id": "Machine",
              "state": "State",
              "instance": "Producer"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Current machine mode",
      "type": "table",
      "description": "Action eligibility depends on mode as well as state. Missing mode remains unknown.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
